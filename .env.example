# Media Streaming Server - Environment Variables
# Copy this file to .env and customize for your deployment

# Flask Configuration
PORT=3000
SECRET_KEY=dev-secret-key-change-in-production

# MediaMTX API
MEDIAMTX_API_URL=http://localhost:8889

# Directories
STREAMS_DIR=/opt/app/streams
LOGS_DIR=/opt/app/logs

# CORS Configuration (optional)
# Comma-separated list of allowed origins for production
# Leave empty or set to * for development (allows all origins)
# CORS_ORIGINS=https://yourdomain.com,https://media.yourdomain.com

# Security (optional)
# API_KEY=your-secure-random-key-here
# ADMIN_API_KEY=different-admin-key-here

# Ingest authorization delegated to SPASA (optional; see mediaMTX.yml)
# Unset = MediaMTX keeps `authMethod: internal` and publishing is authorized by IP
# range (VPN_CIDR) exactly as today. Set all four to hand the decision to SPASA, so a
# device can publish from any network and revoking a user takes effect immediately.
# MTX_AUTHMETHOD=http
# MTX_AUTHHTTPADDRESS=http://127.0.0.1:3000/auth/mediamtx
# SPASA_INGEST_AUTH_URL=https://spasa-server:8443/video/ingest-auth
# SPASA_VIDEO_INGEST_TOKEN=change-me-same-value-as-in-spasa
# CA bundle for SPASA's TLS (empty = system store)
# SPASA_INGEST_AUTH_CA=/opt/app/certs/ca.crt
# false (default) = deny every publish while SPASA is unreachable
# SPASA_INGEST_FAIL_OPEN=false

# Python Configuration
PYTHONUNBUFFERED=1
